# ─────────────────────────────────────────────────────────────────────────────
# Environment variables — copy this file to `.env` and fill in your own values.
#
#   cp .env.example .env
#
# `.env` is git-ignored. NEVER commit it.
# Only COMPOSIO_API_KEY is strictly required to run the daily report locally.
# Everything else has defaults or is only needed for the auto-reply / DM bot.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ────────────────────────────────────────────────────────────────

# Composio hosted MCP key — talks to Instagram on your behalf.
# Get one at https://app.composio.dev → Settings → API Keys.
# On first run, Composio prints an AUTH_URL: click it, log into Instagram,
# approve, then re-run the command.
COMPOSIO_API_KEY=your_composio_key_here

# ── Required for the auto-reply bot (AI replies to comments) ────────────────

# OpenAI key — used by auto-reply.ts to draft contextual replies.
# Get one at https://platform.openai.com/api-keys.
OPENAI_API_KEY=your_openai_key_here

# OpenAI model used for reply generation. gpt-4o is the default.
OPENAI_MODEL=gpt-4o

# ── Optional — Composio user id ─────────────────────────────────────────────

# Identifies WHICH Instagram account inside your Composio workspace.
# Defaults to "instagram-reels-analytics". Only change if you connected
# Instagram under a different user id in Composio.
# COMPOSIO_USER_ID=instagram-reels-analytics

# ── Optional — auto-reply.ts tuning (see .github/workflows/auto-reply.yml) ──

# Max comments to reply to in a single run.
# LIMIT=10

# Max replies per rolling hour (anti-spam guard).
# MAX_PER_HOUR=20

# Skip comments newer than this many minutes (lets you reply manually first).
# SKIP_RECENT_MIN=30

# Delay between replies in ms.
# SLEEP_MS=5000

# ── Optional — build-dm.ts tuning (legacy, the Cloudflare Worker replaces it) ─

# Affiliate link used by the legacy comment→DM script (build-dm.ts).
# The Cloudflare Worker (instagram-dm-bot/) is the live engine now;
# only set this if you want to run build-dm.ts manually as a fallback.
# EMERGENT_LINK=https://app.emergent.sh/register?ref=YOUR_REF

# Trigger keyword to match in comments (case-insensitive).
# KEYWORD=build

# Also post a public reply under the comment (true/false).
# REPLY_PUBLICLY=true

# Ignore comments older than N days (IG private-reply window is 7 days).
# MAX_AGE_DAYS=7

# DM template — {link} is replaced with EMERGENT_LINK.
# DM_TEMPLATE=Yo! Wanna build your own app? Sign up with my link: {link}

# Comma-separated public replies; one is picked at random per match.
# PUBLIC_REPLIES=check your DMs 📩,sent it to you 👀,dropped it in your DMs ✅

# How many recent posts to scan per run.
# SCAN_POSTS=6
